# Load inside Nginx's http context, for example /etc/nginx/conf.d/fablo.conf.
# Replace fablo.example.com before enabling this file. Certbot's Nginx plugin
# can add HTTPS and redirection after this HTTP configuration is loaded.
# Keep Bun bound to 127.0.0.1:3000. Once HTTPS is enabled, set
# PUBLIC_ORIGIN=https://fablo.example.com in backend/.env.

server {
    listen 80;
    server_name fablo.example.com;

    # Match the API's 64 KiB JSON request limit.
    client_max_body_size 64k;

    location / {
        # No URI suffix: preserve /v1 paths and asset version query parameters.
        # All assets go through Bun's authentication and byte-range handling.
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Forward Authorization, cookies, Range and conditional headers as usual.
        # Keep private responses out of any inherited proxy cache, and stream
        # audio downloads without buffering them to temporary files.
        proxy_cache off;
        proxy_buffering off;

        # Generation returns a job immediately; AI work runs in the background.
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
