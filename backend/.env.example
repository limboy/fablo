# Bun loads this file after copying it to .env. Never commit .env.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data

# Generate your own token: openssl rand -hex 32
FABLO_API_TOKEN=replace-with-a-random-token-at-least-32-characters-long
AI_GATEWAY_KEY=replace-with-your-vercel-ai-gateway-key
AI_GATEWAY_URL=https://ai-gateway.vercel.sh
TEXT_MODEL=google/gemini-3.8-flash
IMAGE_MODEL=openai/gpt-image-2.5-sunburst
SPEECH_MODEL=google/gemini-3.8-flash-tts
TRANSCRIPTION_MODEL=microsoft/mai-transcribe-2

# Browser origins for authenticated management; no wildcard. Public reads allow any origin.
# Same-origin needs no entry.
ALLOWED_ORIGINS=
PUBLIC_ORIGIN=https://fablo.example.com
DAILY_JOB_LIMIT=100
MAX_QUEUED_JOBS=30
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
